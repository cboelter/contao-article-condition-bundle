{
  "name": "cboelter/article-condition-bundle",
  "description": "Conditions for contao articles",
  "license": "LGPL-3.0+",
  "type": "contao-module",
  "keywords": [
    "contao",
    "article",
    "condition"
  ],
  "authors": [
    {
      "name": "Christopher Bölter",
      "email": "christopher@boelter.eu",
      "homepage": "http://boelter.eu",
      "role": "Developer"
    }
  ],
  "homepage": "https://boelter.eu",
  "support": {
    "source": "https://github.com/cboelter/contao-article-condition-bundle"
  },
  "require": {
    "php": "^8.4",
    "contao-community-alliance/meta-palettes": "^2.1",
    "contao/core-bundle": "^5.7",
    "contao/manager-plugin": "^2.13",
    "symfony/config": "^7.4",
    "symfony/http-kernel": "^7.4"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.0",
    "phpcq/runner-bootstrap": "@dev"
  },
  "conflict": {
    "contao/manager-plugin": "<2.0 || >=3.0"
  },
  "autoload": {
    "psr-4": {
      "Boelter\\ArticleConditionBundle\\": "src"
    }
  },
  "config": {
    "allow-plugins": {
      "contao-components/installer": true,
      "contao/manager-plugin": true,
      "php-http/discovery": true
    }
  },
  "extra": {
    "contao-manager-plugin": "Boelter\\ArticleConditionBundle\\ContaoManager\\Plugin"
  }
}
